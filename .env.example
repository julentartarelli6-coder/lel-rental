# ----------------------------------------------------------------------------
# Painel administrativo (/admin) — conexão com o Supabase.
#
# Copie este arquivo para .env (desenvolvimento) e cadastre as mesmas
# variáveis na Vercel (Project Settings -> Environment Variables), marcando
# Production, Preview e Development.
#
# Todas são públicas por natureza (vão para o navegador). A segurança vem do
# Row Level Security do banco: a chave anônima só lê o conteúdo do site e só
# grava para quem está logado e é membro do site.
# ----------------------------------------------------------------------------

# Project Settings -> Data API -> Project URL
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Project Settings -> API Keys -> anon / publishable
VITE_SUPABASE_ANON_KEY=cole-a-chave-anon-aqui

# Identificador do site na tabela public.sites (coluna slug)
VITE_SITE_SLUG=lel-rental
